{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^db:generate", "^build"],
			"outputs": ["dist/**", ".output/**", ".astro/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^db:generate"]
		},
		"lint": {},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"db:generate": {
			"cache": false,
			"outputs": ["generated/**"]
		}
	}
}
