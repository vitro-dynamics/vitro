{
	auto_https off
}

:{$PORT:80} {
	root * /srv
	encode gzip zstd
	try_files {path} /index.html
	file_server

	# Long-cache hashed assets (Vite emits content-hashed filenames)
	@hashed path_regexp \.[a-f0-9]{8,}\.(js|css|woff2?|png|jpg|svg|webp)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Never cache the entry HTML
	header /index.html Cache-Control "no-cache, no-store, must-revalidate"
}
