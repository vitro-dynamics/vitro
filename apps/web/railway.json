{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "apps/web/Dockerfile",
		"watchPatterns": [
			"apps/web/**",
			"packages/ui/**",
			"packages/trpc/**",
			"pnpm-lock.yaml",
			"turbo.json"
		]
	},
	"deploy": {
		"startCommand": "caddy run --config /etc/caddy/Caddyfile",
		"restartPolicyType": "ON_FAILURE"
	}
}
