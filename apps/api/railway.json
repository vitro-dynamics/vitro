{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "apps/api/Dockerfile",
		"watchPatterns": [
			"apps/api/**",
			"packages/db/**",
			"packages/trpc/**",
			"packages/logger/**",
			"pnpm-lock.yaml",
			"turbo.json"
		]
	},
	"deploy": {
		"preDeployCommand": "/bin/sh -c 'cd /app/packages/db && node node_modules/.bin/prisma db push --accept-data-loss'",
		"startCommand": "node server/index.mjs",
		"healthcheckPath": "/health",
		"healthcheckTimeout": 30,
		"restartPolicyType": "ON_FAILURE"
	}
}
