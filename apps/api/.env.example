# Database
DATABASE_URL=postgres://app:app@localhost:5432/app

# Better Auth
BETTER_AUTH_SECRET=change-me-use-openssl-rand-hex-32
BETTER_AUTH_URL=https://api.vitro.localhost

# CORS — comma-separated allowed origins
TRUSTED_ORIGINS=https://app.vitro.localhost

# Email — Mailpit catches all email locally (see http://localhost:8025)
RESEND_API_KEY=re_dummy_dev_key
RESEND_FROM_EMAIL=dev@localhost

# Valkey (required)
VALKEY_URL=redis://localhost:6379

# Node
NODE_ENV=development
LOG_LEVEL=debug

# Web Push — VAPID keys (fill in when push goes live)
# Generate once: npx web-push generate-vapid-keys --json
# CRITICAL: never rotate these — doing so invalidates every browser subscription
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Resend webhook (fill in when wiring bounce/complaint handling)
# RESEND_WEBHOOK_SECRET=

# Bird SMS (fill in when SMS goes live)
# BIRD_ACCESS_KEY=
# BIRD_WORKSPACE_ID=
# BIRD_SMS_CHANNEL_ID=

# Bird inbound webhook secret (fill in when wiring STOP/HELP)
# BIRD_WEBHOOK_SECRET=

# Stripe Connect (fill in when payments go live)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID=

# Railway Buckets / S3-compatible storage
# Populated automatically from ${{Bucket.*}} variable references in Railway
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=https://storage.railway.app
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
