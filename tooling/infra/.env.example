# tooling/infra/.env — local tokens for running deployment scripts
#
# Copy to tooling/infra/.env and fill in your values.
# This file is gitignored. Never commit the real .env.
#
# Usage:
#   source tooling/infra/.env && pnpm infra:init
#   source tooling/infra/.env && railway environment dev && railway logs

# ── Railway ───────────────────────────────────────────────────────────────────
# Lets the Railway CLI authenticate without running `railway login` each time.
# Get it from: railway.app → Account Settings → Tokens → Create Token
export RAILWAY_TOKEN=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Fine-grained PAT used to push to protected staging/production branches.
# This is the same value you add to GitHub repo → Secrets → PROMOTE_TOKEN.
# Scopes: Contents: Read & Write — scoped to the staging + production branches.
export GH_TOKEN=

# Tip: `gh auth token` prints your currently active gh CLI token, which works
# for local gh commands but may not have Contents:Write on protected branches.
# Use a dedicated PAT for PROMOTE_TOKEN.
